# Copie ce fichier en ".env" (jamais commité) puis remplis les valeurs.
# Windows PowerShell :  Copy-Item .env.example .env

# Profil actif : free | dataiku | market
PROFILE=free

# --- Palier 0 : Ollama ---
# Local  : http://localhost:11434/v1  (clé inutile ; lent sur CPU : ~85 s par réponse, mesuré)
# Cloud  : https://ollama.com/v1      (clé sur ollama.com/settings/keys ; modèles « -cloud »)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=
OLLAMA_LLM_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=bge-m3
LLM_TIMEOUT_S=600

# --- Palier 1 : Dataiku (clé perso : Profil > Clés d'API) ---
DSS_URL=https://<your-dataiku-instance>
DSS_PROJECT_KEY=TEAM_16
DSS_API_KEY=
# IDs exacts à récupérer avec project.list_llms() (format openai:challenge_llm:<modèle>)
DSS_LLM_ID=
DSS_EMBED_ID=

# --- Palier 2 : autre fournisseur compatible OpenAI (optionnel) ---
MARKET_BASE_URL=
MARKET_API_KEY=
MARKET_LLM_MODEL=
MARKET_EMBED_MODEL=

# --- Diarization (pyannote) ---
HF_TOKEN=
